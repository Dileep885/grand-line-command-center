# ---------------------------------------------------------------
# Firebase web credentials  ->  copy this file to `.env` and fill in
# your own project keys (Firebase Console > Project settings > Web app).
# Keys starting with VITE_ are safe to expose to the browser;
# Firebase security rules are what actually protect your data.
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdefabcdefabcdef
